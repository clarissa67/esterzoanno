<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="esercitazione vettore"/>
        <attribute name="authors" value="NATALONICLARISSA"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-27 09:02:13 "/>
        <attribute name="created" value="TkFUQUxPTklDTEFSSVNTQTtMQUJBSS1QQzE2OzIwMjYtMDQtMjc7IjA4OjI5OjQyICI7MzAzNQ=="/>
        <attribute name="edited" value="TkFUQUxPTklDTEFSSVNTQTtMQUJBSS1QQzE2OzIwMjYtMDQtMjc7IjA5OjAyOjEzICI7MTszMTMz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Nsoluzioni, i, contatore" type="Integer" array="False" size=""/>
            <declare name="somma, media" type="Real" array="False" size=""/>
            <output expression="&quot;scrivi il numero di soluzioni che vuoi analizzare&quot;" newline="True"/>
            <input variable="Nsoluzioni"/>
            <assign variable="somma" expression="0"/>
            <assign variable="contatore" expression="0"/>
            <assign variable="i" expression="0"/>
            <declare name="concentrazione" type="Real" array="True" size="Nsoluzioni"/>
            <for variable="i" start="0" end="Nsoluzioni-1" direction="inc" step="1">
                <assign variable="somma" expression="somma+concentrazione[i]"/>
                <assign variable="i" expression="i+1"/>
                <assign variable="concentrazione[i]" expression="concentrazione"/>
                <if expression="i&lt;Nsoluzioni">
                    <then/>
                    <else>
                        <breakpoint expression="" always="True"/>
                    </else>
                </if>
            </for>
            <assign variable="media" expression="somma/Nsoluzioni"/>
        </body>
    </function>
</flowgorithm>
